    readonly property color video: "#111111"
    readonly property color videoText: "#FFFFFF"
    readonly property color videoMuted: "#BBBBBB"
    readonly property color selected: "#FBEAEB"

    // Levels 0..4 (open … exam-ready) and the colour of their number on them.
    readonly property var levels: ["#E9E6E2", "#F3C7C6", "#E8918F", "#DC5A57", "#CE171E"]
    readonly property var levelTexts: ["#1D1B1A", "#1D1B1A", "#1D1B1A", "#1D1B1A", "#FFFFFF"]
    function levelColor(level) {
        return levels[Math.max(0, Math.min(levels.length - 1, level))]
    }
    function levelTextColor(level) {
        return levelTexts[Math.max(0, Math.min(levelTexts.length - 1, level))]
    }

