pragma Singleton
import QtQuick
import org.kde.kirigami as Kirigami

// Shinki's roles, levels, fonts and sizes (shinki/README.md). Generated by tools/shinki_style.py
// from shinki/tokens.json: change the tokens, never this file.
QtObject {
    id: style

    // A size of the bible (px at 96 dpi) in the platform's units, as Kirigami scales: its
    // gridUnit is gridUnitPx at 96 dpi.
    readonly property int gridUnitPx: 18
    function unit(px) {
        return Math.round(px * Kirigami.Units.gridUnit / gridUnitPx)
    }

    // Colours (section 2).
    readonly property color paper: "#FFFFFF"
    readonly property color paperAlt: "#FAF9F7"
    readonly property color chip: "#F3F1EE"
